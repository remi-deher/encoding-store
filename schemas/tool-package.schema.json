{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/remi-deher/encoding-store/blob/main/schemas/tool-package.schema.json",
  "title": "Encoding Tool Package Manifest",
  "type": "object",
  "required": ["contractVersion", "id", "version", "name", "platform", "executables"],
  "properties": {
    "contractVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["linux-x64", "linux-arm64", "linux-arm", "windows-x64", "windows-arm64", "macos-x64", "macos-arm64"] },
    "executables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["toolId", "path", "sha256"],
        "properties": {
          "toolId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
